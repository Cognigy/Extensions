{
  "name": "workflow-completion",
  "version": "0.0.3",
  "description": "Cognigy Extension for workflow completion tracking with status and session metrics",
  "main": "build/module.js",
  "scripts": {
    "transpile": "tsc -p .",
    "zip": "node zip.js",
    "build": "npm run transpile && npm run lint && npm run zip",
    "lint": "tslint -c tslint.json src/**/*.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "Workflow",
    "Completion",
    "Tracking",
    "Session Metrics",
    "Status"
  ],
  "author": "NiCE",
  "license": "NiCE",
  "dependencies": {
    "@cognigy/extension-tools": "^0.14.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tslint": "^6.1.3",
    "typescript": "^5.9.2"
  }
}