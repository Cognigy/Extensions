{
  "name": "textel-mms",
  "version": "1.0.2",
  "description": "Send SMS/MMS via Textel",
  "main": "build/module.js",
  "scripts": {
    "transpile": "tsc -p .",
    "zip": "node zip.js",
    "build": "npm run transpile && npm run lint && npm run zip",
    "lint": "tslint -c tslint.json src/**/*.ts",
    "test": "npm run transpile && node --test test/",
    "verify": "npm run transpile && npm run lint && node --test test/"
  },
  "keywords": [
    "Textel",
    "MMS",
    "SMS"
  ],
  "author": "NiCE Alexei",
  "license": "NiCE",
  "dependencies": {
    "@cognigy/extension-tools": "^0.14.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "tslint": "^6.1.3"
  }
}
