{
  "name": "twilio",
  "version": "4.1.0",
  "description": "Exposes Twilio functionality to Cognigy.AI",
  "main": "build/module.js",
  "scripts": {
    "transpile": "tsc -p .",
    "zip": "tar cfz twilio.tar.gz build/* package.json package-lock.json README.md icon.png",
    "build": "npm run transpile && npm run lint && npm run zip",
    "lint": "tslint -c tslint.json src/**/*.ts"
  },
  "keywords": [
    "Twilio",
    "SMS"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Cognigy/Extensions"
  },
  "author": "Cognigy GmbH",
  "license": "MIT",
  "dependencies": {
    "@cognigy/extension-tools": "^0.17.0",
    "axios": "^1.13.5"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tslint": "^6.1.2",
    "typescript": "^4.9.5"
  }
}
